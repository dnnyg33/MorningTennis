{
    "rules":
    {
        "sorted-v5":
        {
            "$groupId":
            {
                "$sortingAlgorithm":
                {
                    "$date":
                    {
                        "$dayName":
                        {
                            "players":
                            {
                                "$playerLocation":
                                {
                                    ".write": "data.child('phoneNumber').val() == newData.child('phoneNumber').val() || newData.child('adminUpdated').val() == 'true'",
                                    ".read": true
                                }
                            }
                        }
                    }
                }
            },
            ".write": false,
            ".read": true
        },
        "sorted-v6":
        {
            "$groupId":
            {
                "$sortingAlgorithm":
                {
                    "$date":
                    {
                        "$dayName":
                        {
                            "players":
                            {
                                "$playerLocation":
                                {
                                    ".write": "data.child('phoneNumber').val() == newData.child('phoneNumber').val() || newData.child('adminUpdated').val() == 'true'",
                                    ".read": true
                                }
                            }
                        }
                    }
                }
            },
            ".write": false,
            ".read": true
        },
        "late-submissions":
        {
            ".write": false,
            "$groupId":
            {
                ".write": true
            }
        },
        "rsvps-v1":
        {
            ".read": true,
            ".write": false,
            "$groupId":
            {
                "$date":
                {
                    "$firebaseId":
                    {
                        ".write": true
                    }
                }
            }
        },
        "incoming":
        {
            ".read": true,
            ".write": true
        },
        "incoming-v4":
        {
            "$groupId":
            {
                "$date":
                {
                    "$timestamp":
                    {
                        ".read": true,
                        ".write": "root.child('member_rankings').child($groupId).child(newData.child('firebaseId').val()).child('suspended').val() != true"
                    }
                }
            },
            ".read": true
        },
        "approvedNumbers":
        {
            ".read": true,
            "$phoneNumber":
            {
                ".read": true,
                ".write": "auth != null"
            }
        },
        "groups-v2":
        {
            ".read": true,
            ".write": true,
            "id":
            {
                ".write": true
            }
        },
        "reservations":
        {
            ".read": true,
            ".write": true
        },
        "reservationNotes":
        {
            ".read": true,
            ".write": true
        },
        "member_rankings":
        {
            ".read": true,
            ".write": true
        },
        "subscriptions":
        {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "joinRequests":
        {
            ".read": true,
            ".write": "auth != null"
        },
        "invitedUsers":
        {
            ".read": true,
            ".write": false,
            "$phoneNumber":
            {
                ".write": true
            }
        },
        "ladder_matches":
        {
            ".read": true
        },
        "sets":
        {
            ".write": true,
            ".read": true
        },
        "sets-v2":
        {
            ".write": true,
            ".read": true
        },
        "results-v2":
        {
            ".read": true,
            ".write": false
        }
    }
}